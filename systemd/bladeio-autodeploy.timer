[Unit]
Description=Blade.io : déploiement à heure creuse

[Timer]
# Tous les jours à 5 h (heure du serveur), quand peu de joueurs sont en
# ligne ; le serveur les prévient 60 s avant de redémarrer (tâche T.3).
# Avant : toutes les 30 s, donc à chaque push sur main, en pleine partie.
# Déploiement immédiat : `systemctl start bladeio-autodeploy.service` ou
# lancer auto-deploy.sh à la main.
OnCalendar=*-*-* 05:00:00
Persistent=true

[Install]
WantedBy=timers.target
